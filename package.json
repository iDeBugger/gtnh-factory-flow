{
  "name": "gtnh-factory-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node tools/copy-highs-wasm.mjs && tsx watch --clear-screen=false --include src/server --include src/lib/server src/server/dev.ts",
    "dev:local": "node tools/dev-local.mjs",
    "local-db": "tsx tools/local-db/serve.ts",
    "live": "tsx src/live/main.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node tools/copy-highs-wasm.mjs && vite build && vite build --ssr prerender.tsx --outDir ../../dist/prerender && node tools/build/prerender.mjs",
    "build:server": "node tools/build/build-server.mjs",
    "build:live": "esbuild src/live/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-live/live.mjs --log-level=warning",
    "start": "node dist/server/server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:icons:browsers": "node tools/browser-tests/icon-sizing.mjs",
    "audit:gate": "node tools/audit-gate.mjs",
    "datasets:manifest": "node tools/dataset-pipeline/scripts/rebuild-manifest.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node tools/copy-highs-wasm.mjs",
    "prebuild": "node tools/copy-highs-wasm.mjs",
    "db:types": "tsx tools/db/generate-types.ts",
    "db:migrate": "tsx tools/db/migrate.ts",
    "build:db": "esbuild tools/db/migrate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-db/migrate.mjs --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "express": "5.3.0",
    "gifenc": "^1.0.3",
    "highs": "^1.15.2",
    "html-to-image": "^1.11.13",
    "kysely": "0.29.7",
    "lucide-react": "^1.16.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.3",
    "zod": "^4.6.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "5.0.6",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^29.1.1",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "^4.1.6"
  },
  "volta": {
    "node": "24.21.0"
  }
}
