# A deploy target, read by tools/deploy/deploy.sh and publish-datasets.sh.
# Copy to stage.env (gitignored) on the Mac that deploys.
# The SSH login on the server: in the docker group, reached over ZeroTier.
DEPLOY_SSH=idebugger@tungsten.idebugger.net
# The infra role's directories: compose and .env, then the volumes.
DEPLOY_DIR=/opt/gtnh
DATA_DIR=/srv/gtnh
# The site's origin, baked into the site image (NEXT_PUBLIC_SITE_URL).
SITE_URL=https://stage.gtnhplanner.idebugger.net
# NEXT_PUBLIC_MOD_AND_COMMUNITY at build: off (empty) on stage. Must equal the
# server's .env value.
MOD_AND_COMMUNITY=
