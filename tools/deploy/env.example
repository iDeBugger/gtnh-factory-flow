# The stack's environment: every name tools/deploy/docker-compose.yml reads.
# On the server it is /opt/gtnh/.env (mode 0600), rendered by the infra repo's
# `gtnh` role from 1Password (vault Infra, item gtnh, the field named on each
# line). Placeholders only: never put a real value in this file.
#
# Make each secret with `openssl rand -hex 32`, except the service token:
#   printf %s "$POSTGREST_JWT_SECRET" | node tools/deploy/service-token.mjs
# The deploy checks this file before it starts anything
# (tools/deploy/check-env.mjs) and names any problem, never a value.

# The database superuser's password. 1Password: postgres-password
POSTGRES_PASSWORD=change-me-postgres-password
# PostgREST's login role (authenticator). 1Password: postgrest-authenticator-password
POSTGREST_AUTHENTICATOR_PASSWORD=change-me-authenticator-password
# Signs and checks API tokens, at least 32 characters. 1Password: postgrest-jwt-secret
POSTGREST_JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# A service_role JWT signed with POSTGREST_JWT_SECRET (service-token.mjs). 1Password: postgrest-service-token
POSTGREST_SERVICE_TOKEN=change-me-service-token
# The session secret, the same for site and live by construction (one file feeds both),
# at least 32 characters; changing it signs everyone out. 1Password: community-hash-salt
COMMUNITY_HASH_SALT=change-me-community-hash-salt-32-characters
# The site's bearer for the live service's /internal routes. 1Password: live-internal-token
LIVE_INTERNAL_TOKEN=change-me-live-internal-token-32-characters
# Optional: deletes any community post with x-admin-token. 1Password: community-admin-token
COMMUNITY_ADMIN_TOKEN=
# Optional: opens feedback reports as GitHub issues (Issues read and write). 1Password: github-feedback-token
GITHUB_FEEDBACK_TOKEN=
# Where the game's and the web planner's reports open (owner/name). No default: a report
# whose repo is unset answers 503, like a missing token.
GITHUB_FEEDBACK_REPO=
GITHUB_FEEDBACK_WEB_REPO=

# Settings (role defaults, not secrets).
# Browser origins the live service accepts, https only: the site's origin.
LIVE_ALLOWED_ORIGINS=https://stage.gtnhplanner.idebugger.net
# Peers whose X-Client-Ip the live service believes: the edge network's gateway.
LIVE_TRUSTED_PROXIES=172.30.61.1
# The mod integration and community library: off (empty) on stage. Must equal the
# value the site image was built with.
NEXT_PUBLIC_MOD_AND_COMMUNITY=
# Optional: prewarm every recipe shard at start, not just the indexes.
GTNH_PREWARM_FULL_DATASETS=
# Optional live limits (defaults 64 MB of open plans, 500 rooms).
LIVE_MAX_PLAN_BYTES=
LIVE_MAX_ROOMS=

# release.env, written by tools/deploy/deploy.sh (not by the infra role):
# the images this release runs, and the one before it for a rollback.
GTNH_TAG=4.4.1-00000000
GTNH_PREVIOUS_TAG=
