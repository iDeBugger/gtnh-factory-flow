NEXT_PUBLIC_GTNH_DATASET_MANIFEST_URL=/datasets/gtnh/datasets.manifest.json
# Optional for local UI development: proxy dataset files and /api/datasets to a deployed app.
# GTNH_DATASET_BACKEND_URL=https://dev-gtnh.samiracle.fr
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# The in-game mod integration and the community library. Off unless exactly "on":
# unset, the community plan and public blueprint routes answer 404, the game's
# feedback and live connections are refused, and the web pages say nothing of
# them. Read at build time by the site and at runtime by the live service.
NEXT_PUBLIC_MOD_AND_COMMUNITY=

# Community hub (see docs/COMMUNITY.md). Server-side only — never expose the
# service role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMMUNITY_HASH_SALT=
# Optional: lets the site admin delete any community post via
# DELETE /api/community/plans/<id> with header "x-admin-token: <value>".
COMMUNITY_ADMIN_TOKEN=

# Live plans (docs/live.md). NEXT_PUBLIC_LIVE_URL is read at build time; unset, the
# site has no live features. LIVE_INTERNAL_* let the library routes reach the live
# service. Local development needs none of this: npm run dev:local sets it all.
NEXT_PUBLIC_LIVE_URL=
LIVE_INTERNAL_URL=
LIVE_INTERNAL_TOKEN=
