# Local development. `npm run dev:local` needs none of this (it sets its own
# database, live service and file store); `npm run dev` reads what is set here.
# The deployed stack's environment is in tools/deploy/env.example and docs/deploy.md.

NEXT_PUBLIC_GTNH_DATASET_MANIFEST_URL=/datasets/gtnh/datasets.manifest.json
# Optional for local UI development: proxy dataset files and /api/datasets to a deployed app.
# GTNH_DATASET_BACKEND_URL=https://gtnhplanner.com

# The site's own origin, for every absolute link it writes (metadata, sitemap,
# uploaded image URLs). Read at build time; unset, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# The in-game mod integration and the community library. Off unless exactly "on":
# unset, the community plan and public blueprint routes answer 404, the game's
# feedback and live connections are refused, and the web pages say nothing of
# them. Read at build time by the site and at runtime by the live service.
NEXT_PUBLIC_MOD_AND_COMMUNITY=

# Accounts, cloud plans and the community hub (docs/deploy.md, docs/COMMUNITY.md).
# Server-side only: the service token is a JWT for PostgREST's service_role and
# must never reach the browser.
POSTGREST_URL=
POSTGREST_SERVICE_TOKEN=
# Board images, plan previews and feedback files; unset outside production,
# scratch/local-db/files.
FILE_STORE_DIR=
COMMUNITY_HASH_SALT=
# Optional: lets the site admin delete any community post via
# DELETE /api/community/plans/<id> with header "x-admin-token: <value>".
COMMUNITY_ADMIN_TOKEN=

# Live plans (docs/live.md). NEXT_PUBLIC_LIVE_URL is read at build time; unset, the
# site has no live features. LIVE_INTERNAL_* let the library routes reach the live
# service. Local development needs none of this: npm run dev:local sets it all.
NEXT_PUBLIC_LIVE_URL=
LIVE_INTERNAL_URL=
LIVE_INTERNAL_TOKEN=

# Feedback reports (src/lib/server/CLAUDE.md). Each report opens a GitHub issue
# with the token, on the game's repo or the web planner's (owner/name). No
# default: without the token or the repo a report needs, reports answer 503.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=
GITHUB_FEEDBACK_WEB_REPO=
